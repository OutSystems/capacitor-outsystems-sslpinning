{
  "name": "@outsystems/capacitor-outsystems-sslpinning",
  "version": "1.0.0",
  "description": "OutSystems SSL Pinning plugin - Capacitor Version.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "android/src/main/",
    "android/build.gradle",
    "dist/",
    "ios/Sources/",
    "ios/TrustKit.xcframework",
    "Package.swift",
    "OutsystemsCapacitorOutsystemsSslpinning.podspec"
  ],
  "author": "OutSystems",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/OutSystems/capacitor-outsystems-sslpinning/issues"
  },
  "homepage": "https://github.com/OutSystems/capacitor-outsystems-sslpinning#readme",
  "keywords": [
    "capacitor",
    "plugin",
    "native"
  ],
  "scripts": {
    "verify": "npm run verify:ios && npm run verify:android && npm run verify:web",
    "verify:ios": "xcodebuild build -scheme OutSystemsCapacitorOutSystemsSSLPinning -destination generic/platform=iOS",
    "verify:android": "cd android && ./gradlew clean build test && cd ..",
    "verify:web": "npm run build",
    "lint": "npm run eslint && npm run prettier -- --check && npm run swiftlint -- lint",
    "fmt": "npm run eslint -- --fix && npm run prettier -- --write && npm run swiftlint -- --fix --format",
    "eslint": "eslint . --ext ts",
    "prettier": "prettier \"**/*.{css,html,ts,js,java}\" --plugin=prettier-plugin-java",
    "swiftlint": "node-swiftlint",
    "build": "npm run clean && tsc",
    "clean": "rimraf ./dist"
  },
  "devDependencies": {
    "@capacitor/android": "next",
    "@capacitor/core": "next",
    "@capacitor/ios": "next",
    "@ionic/prettier-config": "^4.0.0",
    "@ionic/swiftlint-config": "^2.0.0",
    "@types/node": "^24.10.1",
    "@typescript-eslint/eslint-plugin": "^8.47.0",
    "@typescript-eslint/parser": "^8.47.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "prettier-plugin-java": "^2.7.7",
    "rimraf": "^6.1.0",
    "swiftlint": "^2.0.0",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@capacitor/core": "next"
  },
  "prettier": "@ionic/prettier-config",
  "swiftlint": "@ionic/swiftlint-config",
  "eslintConfig": {
    "extends": "@ionic/eslint-config/recommended"
  },
  "capacitor": {
    "ios": {
      "src": "ios"
    },
    "android": {
      "src": "android"
    }
  }
}
